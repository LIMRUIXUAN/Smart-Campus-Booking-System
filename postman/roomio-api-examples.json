{
  "info": {
    "name": "Roomio Smart Campus Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080/api" },
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Login Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@campus.test\",\n  \"password\": \"password\"\n}"
        }
      }
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@campus.test\",\n  \"password\": \"password\"\n}"
        }
      }
    },
    {
      "name": "List Resources",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/resources"
      }
    },
    {
      "name": "Check Availability",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/availability?resourceId=r-study-a&pax=2&startDate=2026-06-15&startTime=14:00&endDate=2026-06-15&endTime=15:00",
          "host": ["{{baseUrl}}"],
          "path": ["availability"],
          "query": [
            { "key": "resourceId", "value": "r-study-a" },
            { "key": "pax", "value": "2" },
            { "key": "startDate", "value": "2026-06-15" },
            { "key": "startTime", "value": "14:00" },
            { "key": "endDate", "value": "2026-06-15" },
            { "key": "endTime", "value": "15:00" }
          ]
        }
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceId\": \"r-study-a\",\n  \"eventName\": \"Study session\",\n  \"pax\": 2,\n  \"startDate\": \"2026-06-15\",\n  \"startTime\": \"14:00\",\n  \"endDate\": \"2026-06-15\",\n  \"endTime\": \"15:00\"\n}"
        }
      }
    },
    {
      "name": "My Bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/bookings/my"
      }
    },
    {
      "name": "All Bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/bookings/all"
      }
    },
    {
      "name": "Analytics Summary",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/analytics/summary"
      }
    }
  ]
}
